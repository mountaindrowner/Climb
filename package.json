{
  "name": "the-climb",
  "version": "0.11.0",
  "private": true,
  "description": "A portrait mobile roguelike in chunky 3D: climb a spiral stair from the bottom of an impossibly deep mine to the peak.",
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tools/smoke.mjs",
    "pacing": "node tools/pacing.mjs",
    "portraits": "node tools/portrait.mjs",
    "artifact": "node tools/build-artifact.mjs",
    "check": "npm test && npm run smoke"
  },
  "engines": { "node": ">=18" }
}
